// This is your Prisma schema file for BankSpace PostgreSQL database
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String?   @map("password_hash")
  role         Role      @default(USER)
  isVerified   Boolean   @default(true) @map("is_verified")
  phone        String?
  avatarUrl    String?   @map("avatar_url")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  accounts      Account[]
  sessions      Session[]
  resetTokens   PasswordResetToken[]
  bankAccounts  BankAccount[]
  cards         Card[]
  savingsGoals  SavingsGoal[]
  notifications Notification[]

  @@map("users")
}

model Account {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  provider          String
  providerAccountId String   @map("provider_account_id")
  accessToken       String?  @map("access_token")
  refreshToken      String?  @map("refresh_token")
  expiresAt         Int?     @map("expires_at")
  idToken           String?  @map("id_token")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model BankAccount {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  accountNumber  String   @unique @map("account_number")
  accountName    String   @map("account_name")
  bankName       String   @default("BankSpace Microfinance Bank") @map("bank_name")
  accountType    String   @default("CHECKING") @map("account_type")
  balance        Float    @default(850240.0)
  pendingBalance Float    @default(0.0) @map("pending_balance")
  currency       String   @default("NGN")
  status         String   @default("ACTIVE")
  dailyLimit     Float    @default(1000000.0) @map("daily_limit")
  isPrimary      Boolean  @default(true) @map("is_primary")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactionsSent     Transaction[] @relation("SenderAccount")
  transactionsReceived Transaction[] @relation("RecipientAccount")
  ledgerEntries        LedgerEntry[]

  @@map("bank_accounts")
}

model Transaction {
  id                 String   @id @default(cuid())
  reference          String   @unique
  providerRef        String?  @map("provider_ref")
  senderAccountId    String?  @map("sender_account_id")
  recipientAccountId String?  @map("recipient_account_id")
  senderName         String   @map("sender_name")
  recipientName      String   @map("recipient_name")
  bankName           String   @map("bank_name")
  accountNumber      String   @map("account_number")
  amount             Float
  fee                Float    @default(0.0)
  currency           String   @default("NGN")
  type               String   @default("TRANSFER")
  category           String   @default("Transfer")
  status             String   @default("SUCCESSFUL")
  description        String?
  note               String?
  metadata           String?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  senderAccount    BankAccount?  @relation("SenderAccount", fields: [senderAccountId], references: [id], onDelete: SetNull)
  recipientAccount BankAccount?  @relation("RecipientAccount", fields: [recipientAccountId], references: [id], onDelete: SetNull)
  ledgerEntries    LedgerEntry[]

  @@map("transactions")
}

model LedgerEntry {
  id            String      @id @default(cuid())
  transactionId String      @map("transaction_id")
  bankAccountId String      @map("bank_account_id")
  entryType     String      @map("entry_type")
  amount        Float
  balanceAfter  Float       @map("balance_after")
  createdAt     DateTime    @default(now()) @map("created_at")

  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@map("ledger_entries")
}

model Card {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  cardHolderName String   @map("card_holder_name")
  maskedPan      String   @map("masked_pan")
  cardType       String   @default("VISA") @map("card_type")
  cardCategory   String   @default("VIRTUAL") @map("card_category")
  expiryDate     String   @map("expiry_date")
  status         String   @default("ACTIVE")
  spendingLimit  Float    @default(500000.0) @map("spending_limit")
  colorScheme    String   @default("PURPLE") @map("color_scheme")
  createdAt      DateTime @default(now()) @map("created_at")

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("cards")
}

model SavingsGoal {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  title         String
  targetAmount  Float    @map("target_amount")
  currentAmount Float    @default(0.0) @map("current_amount")
  targetDate    String?  @map("target_date")
  category      String   @default("GENERAL")
  createdAt     DateTime @default(now()) @map("created_at")

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("savings_goals")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
